<% if @error_message %>
  <%= turbo_stream.append "chat-messages" do %>
    <div class="message-wrapper ai">
      <div class="message-bubble ai-message">
        <div class="message-content text-danger">
          <%= @error_message %>
        </div>
        <div class="message-meta d-flex justify-content-between align-items-center mt-2">
          <div class="message-role">
            <i class="bx bx-error-circle"></i>
            System Error
          </div>
          <div class="message-time">
            <%= Time.current.strftime("%I:%M %p") %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
<% else %>
  <%= turbo_stream.append "chat-messages" do %>
    <div class="message-wrapper <%= @message.role %>">
      <div class="message-bubble <%= @message.role == 'user' ? 'user-message' : 'ai-message' %>">
        <div class="message-content">
          <%= @message.content %>
        </div>
        <div class="message-meta d-flex justify-content-between align-items-center mt-2">
          <div class="message-role">
            <% if @message.role == 'user' %>
              <i class="bx bx-user-circle"></i>
              You
            <% else %>
              <i class="bx bx-bot"></i>
              AI Assistant
            <% end %>
          </div>
          <div class="message-time">
            <%= @message.created_at.strftime("%I:%M %p") %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
<% end %>
