<nav data-controller="sidebar" 
    id="sidebar"
    data-turbo-permanent    
    data-sidebar-open-class="open"
    data-sidebar-white-class="bg-white"
    data-sidebar-scroll-class="scroll"
    data-sidebar-menu-class="bx-menu"
    data-sidebar-menu-alt-right-class="bx-menu-alt-right"
    class="sidebar posts shadow" 
    data-sidebar-target="sidebar">

  <div class="logo-details">
    <!-- Icon and logo name -->
    <i class='bx bxl-c-plus-plus icon'></i>
    <div class="logo_name">Codepen</div>
    <i class='bx bx-menu' id="btn" data-sidebar-target="closeBtn" data-action="click->sidebar#toggleSidebar"></i>
    <!-- Menu button to toggle sidebar -->
  </div>
  
    <ul class="nav-list m-0 p-0" data-sidebar-target="navList">
        <!-- Search bar -->
        <li>
            <i class='bx bx-search bg-light-subtle text-light-emphasis' data-sidebar-target="white" data-action="click->sidebar#toggleSidebar"></i>
            <input type="text" class="form-control" placeholder="Search...">
            <span class="tooltip">Search</span>
        </li>
        
        <!-- List of navigation items -->
        <li>
            <%= link_to posts_path, class: "nav-link #{'bg-body-secondary' if current_page?(posts_path)}", data: { bs_toggle: "tooltip", bs_placement: "right", bs_original_title: "Posts" } do %>
                <i class='bx bx-grid-alt <%= "#{'bg-body-secondary' if current_page?(posts_path)}" %>'></i>
                <span class="links_name">Posts</span>
            <% end %>
        </li>
        <li>
            <%= link_to profiles_show_path, data: { bs_toggle: "tooltip", bs_placement: "right", bs_original_title: "Profile" }, class: "nav-link #{'bg-body-secondary' if current_page?(profiles_show_path)}" do %>
                <i class='bx bx-user <%= "#{'bg-body-secondary' if current_page?(profiles_show_path)}" %>'></i>
                <span class="links_name">Profile</span>
            <% end %>
        </li>
        
        <li>
            <a href="#" class="nav-link">
                <i class='bx bx-chat'></i>
                <span class="links_name">Messages</span>
            </a>
            <span class="tooltip">Messages</span>
        </li>
        
        <li>
            <a href="#" class="nav-link">
                <i class='bx bx-pie-chart-alt-2'></i>
                <span class="links_name">Analytics</span>
            </a>
            <span class="tooltip">Analytics</span>
        </li>
        
        <li>
            <a href="#" class="nav-link">
                <i class='bx bx-folder'></i>
                <span class="links_name">File Manager</span>
            </a>
            <span class="tooltip">Files</span>
        </li>
        
        <li>
            <a href="#" class="nav-link">
                <i class='bx bx-cart-alt'></i>
                <span class="links_name">Order</span>
            </a>
            <span class="tooltip">Order</span>
        </li>
        
        <li>
            <a href="#" class="nav-link">
                <i class='bx bx-heart'></i>
                <span class="links_name">Saved</span>
            </a>
            <span class="tooltip">Saved</span>
        </li>
        
        <li>
            <a href="#" class="nav-link">
                <i class='bx bx-cog'></i>
                <span class="links_name">Setting</span>
            </a>
            <span class="tooltip">Setting</span>
        </li>
        
        <!-- Profile section -->
        <li class="profile">
            <div class="profile-details">
                <div class="name_job">
                    <div class="name">Atul Ubarhande</div>
                    <div class="job">@atul.ubarhande</div>
                </div>
                <%= render "/shared/theme" %>
            </div>
            
            <%= button_to destroy_user_session_path, method: :delete, class: "btn" do %>
                <i class='bx bx-log-out bg-light-subtle text-light-emphasis' data-sidebar-target="white" id="log_out"></i>
            <% end %>
        </li>
    </ul>
</nav>
