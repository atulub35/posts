<%= link_to conversation_path(conversation), class: "list-group-item list-group-item-action" do %>
  <div class="d-flex align-items-center">
    <% other_user = conversation.other_participant(current_user) %>
    <div class="flex-shrink-0">
      <% if other_user&.avatar&.attached? %>
        <%= image_tag other_user.avatar_thumbnail, class: "rounded-circle", style: "width: 48px; height: 48px; object-fit: cover;" %>
      <% else %>
        <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
          <i class="bx bx-user text-white"></i>
        </div>
      <% end %>
    </div>
    <div class="flex-grow-1 ms-3">
      <div class="d-flex justify-content-between align-items-center">
        <h6 class="mb-0"><%= other_user&.name || other_user&.email %></h6>
        <small class="text-muted">
          <%= time_ago_in_words(conversation.updated_at) %> ago
        </small>
      </div>
      <p class="mb-0 text-muted small">
        <% if conversation.messages.last %>
          <%= truncate(conversation.messages.last.content, length: 50) %>
        <% else %>
          No messages yet
        <% end %>
      </p>
    </div>
  </div>
<% end %> 