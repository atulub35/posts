<%= turbo_frame_tag "new_conversation" do %>
  <%= vc :TurboModal, title: "New Conversation", modal_size: "modal-md" do |c| %>
    <div class="list-group">
      <% @users.each do |user| %>
        <li class="list-group-item p-0">
          
        <%= button_to conversations_path, 
            method: :post,
            data: { turbo_frame: "_top" },
            params: { user_id: user.id },
            class: "btn list-group-item-action d-flex align-items-center py-3" do %>
          <div class="flex-shrink-0 position-relative">
            <%= vc :Avatar, 
              user: user, 
              size: 40, 
              show_status: true,
              class_names: "me-2"
            %>
          </div>
          <div class="flex-grow-1 ms-3">
            <div class="d-flex align-items-center">
              <h6 class="mb-0 me-2"><%= "#{user.name} (#{user.email})" %></h6>
              <small>
                <% if user.online? %>
                  <span class="text-success">online</span>
                <% elsif user.away? %>
                  <span class="text-warning">away</span>
                <% end %>
              </small>
            </div>
            <small class="text-muted">Click to start chatting</small>
          </div>
        <% end %>
      <% end %>
    </div>
  <% end %>
<% end %>