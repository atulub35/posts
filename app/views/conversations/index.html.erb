<div class="container-fluid h-100">
  <div class="row h-100">
    <div class="col-12 col-md-12 h-100 d-flex flex-column my-4">
      <div class="card flex-grow-1 shadow-sm">
        <div class="card-header bg-body border-bottom d-flex justify-content-between align-items-center">
          <h4 class="mb-0">Conversations</h4>
          <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#newConversationModal">
            <i class="bx bx-plus"></i> New Conversation
          </button>
        </div>
        
        <div class="card-body p-0">
          <% if @conversations.any? %>
            <div class="list-group list-group-flush rounded">
              <%= render partial: "conversation", collection: @conversations %>
            </div>
          <% else %>
            <div class="text-center text-muted py-5">
              <i class="bx bx-message-square-detail display-4 mb-3"></i>
              <p class="mb-0">No conversations yet</p>
              <button type="button" class="btn btn-primary mt-3" data-bs-toggle="modal" data-bs-target="#newConversationModal">
                Start a Conversation
              </button>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- New Conversation Modal -->
<div class="modal fade" id="newConversationModal" tabindex="-1" aria-labelledby="newConversationModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="newConversationModalLabel">Start New Conversation</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="list-group">
          <% User.where.not(id: current_user.id).each do |user| %>
            <%= link_to conversations_path(user_id: user.id), 
                data: { turbo_method: :post },
                class: "list-group-item list-group-item-action d-flex align-items-center" do %>
              <div class="flex-shrink-0 position-relative">
                <div 
                  data-controller="user-avatar" 
                  data-user-avatar-user-id-value="<%= user.id %>" 
                  data-user-avatar-size-value="40"
                  data-initials="<%= user.name&.first&.upcase || user.email.first.upcase %>">
                  <div data-user-avatar-target="placeholder" class="rounded-circle bg-secondary d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                    <i class="bx bx-user text-white"></i>
                  </div>
                </div>
                
                <!-- Status indicator -->
                <div class="position-absolute bottom-0 end-0">
                  <% if user.online? %>
                    <div class="bg-success rounded-circle border border-white" style="width: 10px; height: 10px;"></div>
                  <% elsif user.away? %>
                    <div class="bg-warning rounded-circle border border-white" style="width: 10px; height: 10px;"></div>
                  <% else %>
                    <div class="bg-secondary rounded-circle border border-white" style="width: 10px; height: 10px;"></div>
                  <% end %>
                </div>
              </div>
              <div class="flex-grow-1 ms-3">
                <div class="d-flex align-items-center">
                  <h6 class="mb-0 me-2"><%= user.name || user.email %></h6>
                  <small>
                    <% if user.online? %>
                      <span class="text-success">online</span>
                    <% elsif user.away? %>
                      <span class="text-warning">away</span>
                    <% end %>
                  </small>
                </div>
                <small class="text-muted">Click to start chatting</small>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div> 