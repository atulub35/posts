<div class="container h-100">
  <%= turbo_stream_from @conversation %>
  <div class="row h-100" data-controller="chat-scroll chat-form user-presence" 
             data-current-user-id="<%= @current_user_id %>"
             data-user-presence-conversation-id-value="<%= @conversation.id %>"
             data-user-presence-other-user-id-value="<%= @other_user&.id %>"
             data-action="turbo:submit-end->chat-scroll#messageReceived turbo:before-stream-render->chat-scroll#messageReceived">
    <div class="col-12 col-md-12 h-100 d-flex flex-column my-4">
      <div class="card flex-grow-1 shadow-sm chat-card">
        <div class="card-header bg-body border-bottom d-flex justify-content-between align-items-center">
          <h4 class="mb-0 d-flex align-items-center">
            <% if @other_user %>
              <%= vc :Avatar, 
                user: @other_user, 
                size: 32, 
                class_names: "me-2"
              %>
            <% else %>
              <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center me-2" style="width: 32px; height: 32px;">
                <i class="bx bx-user text-white"></i>
              </div>
            <% end %>
            <%= @other_user&.name || @other_user&.email %>
          </h4>
          <%= render partial: "user_statuses/status", locals: { user: @other_user } %>
        </div>
        
        <div class="card-body chat-container p-3" 
             style="height: calc(100vh - 250px); overflow-y: auto;"
             data-chat-form-target="container"
             data-chat-scroll-target="container">
          <%= turbo_frame_tag "messages", data: { current_user_id: @current_user_id } do %>
            <div id="messages_container" class="d-flex flex-column gap-3" data-chat-form-target="messages">
              <% if @messages.any? %>
                <% @messages.each do |message| %>
                  <div class="message-wrapper <%= message.user == current_user ? 'user' : 'ai' %>" 
                       id="<%= dom_id(message) %>"
                       data-user-id="<%= message.user_id %>"
                       data-chat-scroll-target="message">
                    <div class="message-bubble <%= message.user == current_user ? 'user-message' : 'ai-message' %>">
                      <div class="message-content">
                        <%= message.content %>
                        
                        <% if message.image.attached? %>
                          <div data-controller="s3-image" 
                               data-s3-image-message-id-value="<%= message.id %>"
                               class="mt-2">
                            <div data-s3-image-target="placeholder" class="bg-light rounded p-3 d-flex flex-column align-items-center justify-content-center" style="min-height: 120px; width: 100%;">
                              <div class="spinner-border text-primary mb-2" role="status" style="width: 1.5rem; height: 1.5rem;">
                                <span class="visually-hidden">Loading...</span>
                              </div>
                              <div class="text-center">
                                <small class="text-muted d-block"><%= message.image.filename.to_s %></small>
                                <small class="text-muted d-block">
                                  <%= number_to_human_size(message.image.byte_size) %>
                                </small>
                              </div>
                            </div>
                          </div>
                        <% end %>
                      </div>
                      <div class="message-meta d-flex justify-content-between align-items-center mt-2">
                        <div class="message-role">
                          <% if message.user == current_user %>
                            <i class="bx bx-user-circle"></i>
                            You
                          <% else %>
                            <i class="bx bx-user"></i>
                            <%= message.user ? (message.user.name || message.user.email) : "Unknown User" %>
                          <% end %>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                          <div class="message-time">
                            <%= message.created_at.strftime("%I:%M %p") %>
                          </div>
                          <% if message.user == current_user %>
                            <%= button_to conversation_message_path(@conversation, message), 
                                method: :delete,
                                form: { data: { turbo_confirm: "Delete this message?" } },
                                class: "btn btn-sm btn-link text-danger p-0 d-flex align-items-center" do %>
                              <i class="bx bx-trash-alt"></i>
                            <% end %>
                          <% end %>
                        </div>
                      </div>
                    </div>
                  </div>
                <% end %>
              <% else %>
                <div class="text-center text-muted py-5">
                  <i class="bx bx-message-square-detail display-4 mb-3"></i>
                  <p class="mb-0">No messages yet</p>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>

        <div class="card-footer bg-body border-top p-3">
          <%= form_with model: [@conversation, @message], 
                        id: dom_id(@conversation, 'message_form'),
                        data: { 
                          chat_form_target: "form",
                          turbo_frame: "messages",
                          turbo: true
                        }, 
                        class: "chat-input-form" do |f| %>
            <div class="input-group">
              <%= f.hidden_field :role, value: 'user' %>
              <%= f.text_area :content, 
                  placeholder: "Type your message...", 
                  class: "form-control border-0 bg-body-tertiary rounded-start-pill ps-4", 
                  rows: 1,
                  style: "resize: none;",
                  data: { 
                    chat_form_target: "input",
                    controller: "textarea-autogrow",
                    action: "keydown->textarea-autogrow#resize"
                  } %>
              <label class="btn btn-light rounded-0 d-flex align-items-center justify-content-center px-3" title="Add image">
                <i class="bx bx-image"></i>
                <%= f.file_field :image, 
                    class: "d-none", 
                    accept: "image/png,image/gif,image/jpeg", 
                    data: { chat_form_target: "imageInput" } %>
              </label>
              <button data-action="chat-form#submit" class="btn btn-primary rounded-end-pill px-4">
                <i class="bx bx-send"></i>
              </button>
            </div>
            <div class="image-preview mt-2 d-none" data-chat-form-target="imagePreview">
              <div class="position-relative d-inline-block">
                <img src="" class="rounded" style="max-height: 100px; max-width: 200px;" data-chat-form-target="previewImage">
                <button type="button" class="btn btn-sm btn-danger position-absolute top-0 end-0 rounded-circle" style="margin-top: -10px; margin-right: -10px;" data-action="chat-form#removeImage">
                  <i class="bx bx-x"></i>
                </button>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
    <!-- Hidden presence form -->
    <%= form_with url: publish_user_statuses_path, 
                  id: "presence_form", 
                  method: :post,
                  local: false,
                  style: "display: none;",
                  data: { 
                    user_presence_target: "form",
                    turbo: true,
                    turbo_frame: "_top"
                  } do |f| %>
      <%= f.hidden_field :status, value: "online", data: { user_presence_target: "statusField" } %>
      <%= f.hidden_field :conversation_id, value: @conversation.id %>
      <%= f.hidden_field :authenticity_token, value: form_authenticity_token %>
    <% end %>
  </div>
  
</div> 