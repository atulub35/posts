<div class="message-item <%= message.user == current_user ? 'sent' : 'received' %>" id="message_<%= message.id %>">
  <div class="<%= message.user == current_user ? 'bg-blue-100 ml-auto' : 'bg-gray-100' %> p-3 rounded-lg mb-2 max-w-xs md:max-w-md">
    <div class="message-content">
      <%= message.content %>
      
      <% if message.image.attached? %>
        <div data-controller="s3-image" 
             data-s3-image-message-id-value="<%= message.id %>"
             class="mt-2">
          <div data-s3-image-target="placeholder" class="bg-gray-200 rounded-lg p-3 flex items-center justify-center" style="min-height: 100px; min-width: 100px;">
            <span class="text-gray-500">Loading image...</span>
          </div>
        </div>
      <% end %>
    </div>
    
    <div class="text-xs text-gray-500 mt-1">
      <%= message.created_at.strftime("%I:%M %p") %>
    </div>
  </div>
</div> 