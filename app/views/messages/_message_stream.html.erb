<div class="message <%= message.user_id == user_id ? 'message-sent' : 'message-received' %>">
  <div class="message-content <%= message.user_id == user_id ? 'bg-primary text-white' : 'bg-body-tertiary' %> rounded-3 p-3">
    <div class="d-flex align-items-center mb-1">
      <% if message.user && message.user.avatar.attached? %>
        <span class="rounded-circle me-2 d-inline-block" style="width: 24px; height: 24px; background-image: url('<%= url_for(message.user.avatar) %>'); background-size: cover;"></span>
      <% else %>
        <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center me-2" style="width: 24px; height: 24px;">
          <i class="bx bx-user text-white"></i>
        </div>
      <% end %>
      <small class="<%= message.user_id == user_id ? 'text-white-50' : 'text-muted' %>">
        <%= message.user ? (message.user.name || message.user.email) : "Unknown User" %>
      </small>
    </div>
    <p class="mb-0"><%= message.content %></p>
    <small class="<%= message.user_id == user_id ? 'text-white-50' : 'text-muted' %>">
      <%= time_ago_in_words(message.created_at) %> ago
    </small>
  </div>
</div> 