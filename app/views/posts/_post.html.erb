<%= turbo_frame_tag dom_id(post) do %>
    <div class="card my-2 border rounded-3">
        <%= content_tag :div, class: "row g-0 p-3" do %>
            <%#= turbo_stream_from post %>
            <div class="col-12 col-md-9">
                <div class="d-flex flex-column h-100">
                    <h5><span class="badge text-bg-secondary fw-light"><%= time_ago_in_words(post.created_at) %></span></h5>
                    <%= content_tag :div, post.body, class: "flex-grow-1 text-truncate" %>
                    <%= content_tag :small, post&.user&.name, class: "text-truncate" %>
                </div>
            </div>
            <div class="col-12 col-md-3">
                <%#= image_tag "https://api.adorable.io/avatars/285/#{post.id}.png", size: "18x18" %>
                <%#= content_tag :div, post.email, class: "px-3" %>
                <%= content_tag :div, class: "d-flex flex-column align-items-end gap-3" do %>
                   <div class="rounded" style="background-image: url(<%= "https://api.dicebear.com/9.x/personas/svg?seed=#{post&.user&.name[0,5]}" %>); background-size: cover;height: 45px;width: 45px;"></div>
                    <div class="d-flex flex-column gap-3 align-items-center flex-sm-row">
                        <a data-turbo-stream class="dropdown-item d-flex gap-2 align-items-center" href="<%= repost_post_path(post) %>">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-share-2"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line></svg>
                            (<%= post.repost_count %>)
                        </a>
                        <a data-turbo-stream class="dropdown-item d-flex gap-2 align-items-center" href="<%= like_post_path(post) %>">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-heart"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                            (<%= post.likes_count %>)
                        </a>
                        <div class="dropdown">
                            <button class="btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-settings"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
                            </button>
                            <ul class="dropdown-menu mx-0 shadow" data-bs-theme="light">
                                <li>
                                    <%= button_to post_path(post), method: :get, data: { turbo_frame: "show" }, params: { type: "show"}, class: 'dropdown-item d-flex gap-2 align-items-center' do %>
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-eye"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                                        View
                                    <% end %>
                                </li>
                                <li>
                                    <%= button_to edit_post_path(post), method: :get, data: { turbo_frame: "edit_post" }, class: 'dropdown-item d-flex gap-2 align-items-center' do %>
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-edit-2"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"></path></svg>
                                        Edit
                                    <% end %>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <%= button_to post_path(post), method: :get, data: { turbo_frame: "show" }, params: { type: "delete"}, class: 'dropdown-item d-flex gap-2 align-items-center text-danger' do %>
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-trash"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                        Delete
                                    <% end %>
                                </li>
                            </ul>
                        </div>
                    </div>
                <% end %>
            </div>
        <% end %>
    </div>
<% end %>