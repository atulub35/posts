
<%= vc :TurboModal, title: title, modal_size: params[:type] == "delete" ? "modal-md" : "modal-lg" do |c| %>
    <% if params[:type] == "delete" %>
        <%= form_with model: @post, method: :delete, data: { modal_form_target: "form" } do |form| %>
            You want to delete this post?
            <%= form.hidden_field :id, value: @post.id %>
            <% c.with_footer do %>
                <button type="button" class="btn btn-danger" data-turbo-modal-target="button" data-action="modal-form#submitModalForm">Delete</button>
            <% end %>
        <% end %>
    <% else %>
        <%= form_with model: @post, id: dom_id(@post), html: { class: 'flex-grow-1' }, data: { modal_form_target: "form" } do |f| %>
            <% if @post.errors.any? %>
            <div id="error_explanation">
            <h2>
                <%= pluralize(@post.errors.count, "error") %> prohibited this post from
                being saved:
            </h2>
            <ul>
                <% @post.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
                <% end %>
            </ul>
            </div>
            <% end %>
            <div class="form-group">
                <div class="mb-3">
                    <%= f.label :title, 'Title', class: 'form-label' %>
                    <%= f.text_field :title, placeholder: 'Enter your title', class: 'form-control' %>
                </div>
                <%#= f.hidden_field :user_id, value: 1 %>
                <div class="mb-3">
                    <%= f.label :body, 'Body', class: 'form-label' %>
                    <%= f.rich_text_area :body, placeholder: 'Enter your thoughts', class: 'form-control', rows: 3 %>
                </div>
            </div>
        <% end %>
        <% c.with_footer do %>
            <button type="button" class="btn btn-primary" data-turbo-modal-target="button" data-action="modal-form#submitModalForm">Save changes</button>
        <% end %>
    <% end %>
<% end %>