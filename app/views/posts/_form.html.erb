<%= vc :TurboModal, title: title, modal_size: params[:type] == "delete" ? "modal-md" : "modal-lg" do |c| %>
    <% if params[:type] == "delete" %>
        <%= form_with model: @post, method: :delete, data: { modal_form_target: "form" } do |form| %>
            <div class="text-center">
                <i class="fas fa-exclamation-triangle text-warning mb-3" style="font-size: 3rem;"></i>
                <p class="lead">Are you sure you want to delete this post?</p>
                <p class="text-muted">This action cannot be undone.</p>
            </div>
            <%= form.hidden_field :id, value: @post.id %>
            <% c.with_footer do %>
                <button type="button" class="btn btn-danger" data-turbo-modal-target="button" data-action="modal-form#submitModalForm">
                    <i class="fas fa-trash-alt me-2"></i>Delete
                </button>
            <% end %>
        <% end %>
    <% else %>
        <%= form_with model: @post, id: dom_id(@post), html: { class: 'flex-grow-1' }, data: { modal_form_target: "form" } do |f| %>
            <% if @post.errors.any? %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <h4 class="alert-heading">
                        <%= pluralize(@post.errors.count, "error") %> prohibited this post from being saved:
                    </h4>
                    <ul class="mb-0">
                        <% @post.errors.full_messages.each do |msg| %>
                            <li><%= msg %></li>
                        <% end %>
                    </ul>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            <% end %>

            <div class="form-group">
                <div class="mb-4">
                    <%= f.label :title, 'Title', class: 'form-label fw-bold' %>
                    <%= f.text_field :title, 
                        placeholder: 'Enter your title', 
                        class: 'form-control form-control-lg',
                        data: { 
                            controller: "autosave",
                            action: "input->autosave#save",
                            autosave_delay_value: 1000
                        } %>
                </div>
                
                <div class="mb-4">
                    <%= f.label :body, 'Body', class: 'form-label fw-bold' %>
                    <%= f.rich_text_area :body, 
                        placeholder: 'Enter your thoughts', 
                        class: 'form-control',
                        rows: 8,
                        data: { 
                            controller: "autosave",
                            action: "input->autosave#save",
                            autosave_delay_value: 1000
                        } %>
                </div>
            </div>
        <% end %>
        <% c.with_footer do %>
            <button type="button" class="btn btn-primary" data-turbo-modal-target="button" data-action="modal-form#submitModalForm">
                <i class="fas fa-save me-2"></i>Save changes
            </button>
        <% end %>
    <% end %>
<% end %>