<div class="container py-4">
  <% if user_signed_in? %>
    <div class="row mb-4">
      <div class="col-md-12">
        <div class="card shadow-sm">
          <div class="card-body">
            <div class="d-flex align-items-center">
              <% if current_user.avatar.attached? %>
                <%= image_tag current_user.avatar, class: "rounded-circle me-3", style: "width: 64px; height: 64px; object-fit: cover;" %>
              <% else %>
                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center me-3" style="width: 64px; height: 64px;">
                  <%= current_user.email.first.upcase %>
                </div>
              <% end %>
              <div>
                <h4 class="mb-1">Welcome, <%= current_user.name || current_user.email %></h4>
                <p class="text-muted mb-0">
                  You have <%= link_to pluralize(@stats[:posts_count], 'post'), posts_path, class: "text-decoration-none" %>,
                  <%= link_to pluralize(@stats[:chat_messages_count], 'chat message'), chats_path, class: "text-decoration-none" %>,
                  and <%= link_to pluralize(@stats[:conversations_count], 'conversation'), conversations_path, class: "text-decoration-none" %>
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="row g-4">
      <!-- Posts Card -->
      <div class="col-md-6 col-lg-4">
        <div class="card h-100 shadow-sm">
          <div class="card-body">
            <h5 class="card-title">
              <i class="bx bx-file-blank me-2"></i>Posts
            </h5>
            <p class="card-text">Create and manage your posts. Share your thoughts with the world!</p>
            <div class="d-flex justify-content-between align-items-center">
              <%= link_to "View Posts", posts_path, class: "btn btn-primary" %>
              <%= link_to "New Post", new_post_path, class: "btn btn-outline-primary" %>
            </div>
          </div>
          <div class="card-footer">
            <small class="text-muted"><%= pluralize(@stats[:posts_count], 'post') %> created</small>
          </div>
        </div>
      </div>

      <!-- AI Chat Card -->
      <div class="col-md-6 col-lg-4">
        <div class="card h-100 shadow-sm">
          <div class="card-body">
            <h5 class="card-title">
              <i class="bx bx-bot me-2"></i>AI Chat
            </h5>
            <p class="card-text">Chat with our AI assistant. Get help, answers, and insights instantly!</p>
            <%= link_to "Start Chat", chats_path, class: "btn btn-primary" %>
          </div>
          <div class="card-footer">
            <small class="text-muted"><%= pluralize(@stats[:chat_messages_count], 'message') %> exchanged with AI</small>
          </div>
        </div>
      </div>

      <!-- Private Messaging Card -->
      <div class="col-md-6 col-lg-4">
        <div class="card h-100 shadow-sm">
          <div class="card-body">
            <h5 class="card-title">
              <i class="bx bx-message-rounded-dots me-2"></i>Conversations
            </h5>
            <p class="card-text">Send private messages to other users with secure S3 image attachments.</p>
            <div class="d-flex justify-content-between align-items-center">
              <%= link_to "All Conversations", conversations_path, class: "btn btn-primary" %>
              <% if @recent_conversation %>
                <%= link_to "Latest Chat", conversation_path(@recent_conversation), class: "btn btn-outline-primary" %>
              <% end %>
            </div>
          </div>
          <div class="card-footer">
            <small class="text-muted"><%= pluralize(@stats[:private_messages_count], 'private message') %> in <%= pluralize(@stats[:conversations_count], 'conversation') %></small>
          </div>
        </div>
      </div>

      <!-- Image Generation Card -->
      <div class="col-md-6 col-lg-4">
        <div class="card h-100 shadow-sm border-primary">
          <div class="card-header bg-primary text-white">
            <i class="bx bx-image me-2"></i>AI Image Generation
          </div>
          <div class="card-body">
            <p class="card-text">Generate stunning images from text descriptions using AI or create variations of existing images.</p>
            <div class="d-flex flex-column gap-2">
              <%= link_to new_image_path, class: "btn btn-primary" do %>
                <i class="bx bx-plus-circle me-1"></i> Create New Image
              <% end %>
              <%= link_to new_variant_images_path, class: "btn btn-outline-primary" do %>
                <i class="bx bx-images me-1"></i> Create Image Variation
              <% end %>
              <%= link_to images_path, class: "btn btn-outline-secondary mt-2" do %>
                <i class="bx bx-photo-album me-1"></i> View My Images
              <% end %>
            </div>
          </div>
          <div class="card-footer">
            <small class="text-muted"><%= pluralize(@stats[:image_generations_count], 'image') %> generated with AI</small>
          </div>
        </div>
      </div>

      <!-- Profile Card -->
      <div class="col-md-6 col-lg-4">
        <div class="card h-100 shadow-sm">
          <div class="card-body">
            <h5 class="card-title">
              <i class="bx bx-user-circle me-2"></i>Profile
            </h5>
            <p class="card-text">Manage your profile settings, avatar and preferences.</p>
            <div class="d-flex flex-column gap-2">
              <%= link_to edit_profile_path, class: "btn btn-primary" do %>
                <i class="bx bx-edit me-1"></i> Edit Profile
              <% end %>
              <%= link_to profile_path, class: "btn btn-outline-primary" do %>
                <i class="bx bx-user me-1"></i> View My Profile
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <!-- Data Settings Card -->
      <div class="col-md-6 col-lg-4">
        <div class="card h-100 shadow-sm">
          <div class="card-body">
            <h5 class="card-title">
              <i class="bx bx-cog me-2"></i>App Settings
            </h5>
            <p class="card-text">Configure application preferences and data usage settings.</p>
            
            <div class="form-check form-switch mb-3">
              <input class="form-check-input" type="checkbox" role="switch" id="dataSavingToggle" data-controller="data-saving" data-action="change->data-saving#toggle">
              <label class="form-check-label" for="dataSavingToggle">Data-saving mode</label>
              <div class="form-text">Only load images when needed to save bandwidth</div>
            </div>
            
            <div class="d-flex justify-content-between align-items-center">
              <%= button_to destroy_user_session_path, method: :delete, class: "btn btn-outline-danger" do %>
                <i class="bx bx-log-out me-1"></i> Sign Out
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% else %>
    <div class="row justify-content-center">
      <div class="col-md-6 col-lg-4">
        <div class="card shadow">
          <div class="card-body text-center p-5">
            <h2 class="mb-4">Welcome!</h2>
            <p class="mb-4">Please sign in to access all features.</p>
            <div class="d-grid gap-3">
              <%= button_to "Sign In", new_user_session_path, class: "btn btn-primary btn-lg" %>
              <%= link_to "Sign Up", new_user_registration_path, class: "btn btn-outline-primary btn-lg" %>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>