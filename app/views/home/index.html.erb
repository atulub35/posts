<div class="container py-4">
  <% if user_signed_in? %>
    <div class="row mb-4">
      <div class="col-md-12">
        <div class="card shadow-sm">
          <div class="card-body">
            <div class="d-flex align-items-center">
              <% if current_user.avatar.attached? %>
                <%= image_tag current_user.avatar, class: "rounded-circle me-3", style: "width: 64px; height: 64px; object-fit: cover;" %>
              <% else %>
                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center me-3" style="width: 64px; height: 64px;">
                  <%= current_user.email.first.upcase %>
                </div>
              <% end %>
              <div>
                <h4 class="mb-1">Welcome, <%= current_user.name || current_user.email %></h4>
                <p class="text-muted mb-0">You have <%= link_to pluralize(current_user.posts.count, 'post'), posts_path, class: "text-decoration-none" %></p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="row g-4">
      <!-- Posts Card -->
      <div class="col-md-6 col-lg-4">
        <div class="card h-100 shadow-sm">
          <div class="card-body">
            <h5 class="card-title">
              <i class="bi bi-file-text me-2"></i>Posts
            </h5>
            <p class="card-text">Create and manage your posts. Share your thoughts with the world!</p>
            <div class="d-flex justify-content-between align-items-center">
              <%= link_to "View Posts", posts_path, class: "btn btn-primary" %>
              <%= link_to "New Post", new_post_path, class: "btn btn-outline-primary" %>
            </div>
          </div>
        </div>
      </div>

      <!-- AI Chat Card -->
      <div class="col-md-6 col-lg-4">
        <div class="card h-100 shadow-sm">
          <div class="card-body">
            <h5 class="card-title">
              <i class="bi bi-chat-dots me-2"></i>AI Chat
            </h5>
            <p class="card-text">Chat with our AI assistant. Get help, answers, and insights instantly!</p>
            <%= link_to "Start Chat", chats_path, class: "btn btn-primary" %>
          </div>
        </div>
      </div>

      <!-- Image Generation Card -->
      <div class="col-md-6 col-lg-4">
        <div class="card h-100 shadow-sm">
          <div class="card-body">
            <h5 class="card-title">
              <i class="bi bi-image me-2"></i>Image Generation
            </h5>
            <p class="card-text">Create unique images using AI. Transform your ideas into visuals!</p>
            <%= link_to "Generate Images", images_path, class: "btn btn-primary" %>
          </div>
        </div>
      </div>

      <!-- JWT Status Card -->
      <div class="col-md-6 col-lg-4">
        <div class="card h-100 shadow-sm">
          <div class="card-body">
            <h5 class="card-title">
              <i class="bi bi-shield-lock me-2"></i>JWT Status
            </h5>
            <p class="card-text">Your JWT token is active and valid for API authentication.</p>
            <div class="d-flex justify-content-between align-items-center">
              <span class="badge bg-success">Active</span>
              <%= button_to "Sign Out", destroy_user_session_path, method: :delete, class: "btn btn-outline-danger" %>
            </div>
          </div>
        </div>
      </div>

      <!-- Profile Card -->
      <div class="col-md-6 col-lg-4">
        <div class="card h-100 shadow-sm">
          <div class="card-body">
            <h5 class="card-title">
              <i class="bi bi-person-circle me-2"></i>Profile
            </h5>
            <p class="card-text">Manage your profile settings and preferences.</p>
            <%= link_to "Edit Profile", edit_profile_path, class: "btn btn-primary" %>
          </div>
        </div>
      </div>
    </div>
  <% else %>
    <div class="row justify-content-center">
      <div class="col-md-6 col-lg-4">
        <div class="card shadow">
          <div class="card-body text-center p-5">
            <h2 class="mb-4">Welcome!</h2>
            <p class="mb-4">Please sign in to access all features.</p>
            <div class="d-grid gap-3">
              <%= button_to "Sign In", new_user_session_path, class: "btn btn-primary btn-lg" %>
              <%= link_to "Sign Up", new_user_registration_path, class: "btn btn-outline-primary btn-lg" %>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>