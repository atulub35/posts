<div class="container py-5">
  <div class="row">
    <div class="col-12">
      <% if @generated_images.present? %>
        <div class="d-flex justify-content-between align-items-center mb-4">
          <h2>Your Generated Images</h2>
          <div>
            <%= link_to "Generate New Image", new_image_path, class: "btn btn-primary me-2" %>
            <%= link_to "Generate House Variants", new_variant_images_path, class: "btn btn-success" %>
          </div>
        </div>
        
        <div class="row">
          <% @generated_images.each do |image| %>
            <div class="col-md-4 mb-4">
              <div class="card">
                <img src="<%= image[:url] %>" class="card-img-top" alt="Generated image">
                <div class="card-body">
                  <p class="card-text text-muted small"><%= truncate(image[:prompt], length: 100) %></p>
                  <p class="card-text text-muted small">Created: <%= Time.at(image[:created_at]).strftime("%B %d, %Y") %></p>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="text-center py-5">
          <h3 class="text-muted">No images generated yet</h3>
          <p class="text-muted">Start by creating your first AI-generated image!</p>
          <div class="mt-3">
            <%= link_to "Generate Your First Image", new_image_path, class: "btn btn-primary me-2" %>
            <%= link_to "Generate House Variants", new_variant_images_path, class: "btn btn-success" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
