<h1 class="text-center mt-3 mb-4">Generate Images with AI 🤖</h1>

<div id="chat-container" class="container">
    <div data-controller="modal-form" data-action="turbo:submit-start->modal-form#onSubmitStart turbo:submit-end->modal-form#onSubmitEnd">
        <%= form_with url: images_path, method: :post, data: { turbo_frame: "chat-messages", modal_form_target: "form" }, class: "form-control rounded-3 ai-form p-2" do |form| %>
            <div class="form-floating">
                <%= form.text_area :prompt, placeholder: "Any ideas for an image...", required: true, style: "100px", class: "p-3 w-100 border-0" %>
            </div>
            <div class="d-flex justify-content-between align-items-center gap-3 mt-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-image"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                <button type="submit" class="btn btn-primary d-flex gap-2 align-items-center" data-modal-form-target="button">
                    Send
                </button>
            </div>
        <% end %>
    </div>
    <turbo-frame id="image_result">
    <!-- Image result will be updated dynamically here -->
    </turbo-frame>
</div>

