<%= turbo_stream.replace "image_result" do %>
  <div class="mt-4">
    <% if @image_url %>
      <div class="card shadow-sm">
        <div class="card-body text-center">
          <h3 class="mb-3">Your Generated Image</h3>
          <div class="position-relative">
            <img src="<%= @image_url %>" alt="Generated AI Image" class="img-fluid rounded-3 shadow-sm">
            <div class="position-absolute top-0 end-0 m-3">
              <a href="<%= @image_url %>" target="_blank" class="btn btn-light btn-sm shadow-sm">
                <i class="bi bi-download"></i> Download
              </a>
            </div>
          </div>
          <div class="mt-3">
            <p class="text-muted mb-0">Prompt: <%= params[:prompt] %></p>
          </div>
        </div>
      </div>
    <% elsif @error_message %>
      <div class="alert alert-danger" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>
        <%= @error_message %>
      </div>
    <% end %>
  </div>
<% end %>
