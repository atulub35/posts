<div class="row">
    <div class="col-12 col-md-8 offset-0 offset-md-2">
        <div class="profile-card card my-2 border rounded-3 mt-3">
            <%= form_for @user, url: profile_path, method: :patch, html: { multipart: true } do |f| %>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-12 col-sm-6">
                            <div class="d-flex align-items-center gap-3">
                                <div class="mb-2 text-center">
                                    <%= vc :Avatar, 
                                      user: @user, 
                                      size: 100, 
                                      class_names: "mx-auto"
                                    %>
                                </div>
                                <div class="">
                                    <h5 class="card-title">
                                        <%= "Edit " unless show %>
                                        Profile
                                    </h5>
                                    <p class="card-text">Change your account settings</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6">
                            <div class="d-flex justify-content-end">
                                <% if show %>
                                    <%= link_to 'Edit Profile', edit_profile_path, class: 'btn btn-primary' %>  
                                <% else %>
                                    <%= link_to "Cancel", profiles_show_path, class: "btn text-primary" %>
                                    <%= button_tag "Update", class: "btn btn-primary" %>
                                <% end %>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div 
                        data-controller="progress-wrapper"
                        data-action="turbo:submit-start->progress-wrapper#showLoading turbo:submit-end->progress-wrapper#stopLoading">
                        <div class="row">
                            <div class="col-12 col-sm-6 mb-3">
                                <%= f.label :name, class: "form-label fs-6" %>
                                <%= f.text_field :name, readonly: show, autofocus: true, class: "form-control fw-light #{"border-transparent" if show}" %>
                            </div>
                            
                            <div class="col-12 col-sm-6 mb-3" data-controller="avatar-preview">
                                <% unless show %>
                                    <div class="mb-3">
                                        <%= f.label :avatar, class: "form-label fs-6" %>
                                        <%= f.file_field :avatar, 
                                            class: "form-control fw-light", 
                                            accept: "image/png,image/jpeg,image/jpg",
                                            data: { 
                                                action: "change->avatar-preview#previewAvatar",
                                                avatar_preview_target: "input" 
                                            } 
                                        %>
                                        <div class="form-text">Upload a profile picture (PNG, JPG formats only)</div>
                                    </div>
                                    
                                    <% if @user.avatar.attached? %>
                                    <div class="form-check mb-3">
                                        <%= f.check_box :remove_avatar, class: "form-check-input" %>
                                        <%= f.label :remove_avatar, 'Remove current avatar', class: "form-check-label" %>
                                    </div>
                                    <% end %>
                                <% end %>
                            </div>

                            <div class="col-12 col-sm-6 mb-3">
                                <%= f.label :email, class: "form-label fs-6" %>
                                <%= f.email_field :email, readonly: show, class: "form-control fw-light #{"border-transparent" if show}" %>
                            </div>
                            <div class="col-12 col-sm-6 mb-3">
                                <%= f.label :phone_number, class: "form-label fs-6" %>
                                <%= f.text_field :phone_number, readonly: show, class: "form-control fw-light #{"border-transparent" if show}" %>
                            </div>

                            <div class="col-12 col-sm-6 mb-3">
                                <%= f.label :language, class: "form-label fs-6" %>
                                <%= f.text_field :language, readonly: show, class: "form-control fw-light #{"border-transparent" if show}" %>
                            </div>

                            <div class="col-12 col-sm-6 mb-3">
                                <%= f.label :timezone, class: "form-label fs-6" %>
                                <%#= f.text_field :timezone, readonly: show, class: "form-control fw-light #{"border-transparent" if show}" %>
                                <%#= f.time_zone_select :timezone, ActiveSupport::TimeZone.us_zones, {:class => 'form-control fw-light #{"border-transparent" if show}'} %>
                                <%= f.time_zone_select :timezone, ActiveSupport::TimeZone.us_zones, {}, disabled: show, class: "form-select fw-light #{"border-transparent" if show}" %>
                            </div>
                        </div>
                    </div>
                </div>
            <% end %>
        </div>
    </div>
</div>